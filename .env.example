# Neon PostgreSQL
# From Neon Connect dialog:
# - DATABASE_URL = pooled connection (-pooler in host)
# - DIRECT_URL   = direct connection (no -pooler)
#
# If Prisma fails with P1001 on Windows while the Neon project is Active,
# run: node scripts/fix-neon-ipv4.mjs
# (forces IPv4 via hostaddr — IPv6 often times out on some networks)

DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional (production uploads)
# BLOB_READ_WRITE_TOKEN=

# Canonical site URL for SEO (Open Graph, sitemap, JSON-LD). Use your real domain in production.
# NEXT_PUBLIC_SITE_URL=https://mousamarsh.com
